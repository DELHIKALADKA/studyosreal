{
  "name": "StudyOS — Your Personal Study Operating System",
  "short_name": "StudyOS",
  "description": "Plan, study, practise, revise and track your progress. Works offline, stores everything on your device.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0b0d12",
  "theme_color": "#0b0d12",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Start a study session", "url": "./index.html#timer", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today's homework", "url": "./index.html#homework", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Smart revision", "url": "./index.html#revision", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Ask the tutor", "url": "./index.html#tutor", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
